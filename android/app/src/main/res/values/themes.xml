<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ritm" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/r_bg</item>
        <item name="android:colorAccent">@color/r_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Ritm.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/alarm_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
