<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/p_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/p_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/r_ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="План дня" />
            <TextView android:id="@+id/p_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/r_muted" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <ImageView android:id="@+id/p_add" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_plus" android:tint="@color/r_accent" android:contentDescription="Добавить" />
    </LinearLayout>
    <ProgressBar android:id="@+id/p_progress" style="@android:style/Widget.Material.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressTint="@color/r_calm" android:progressBackgroundTint="@color/r_line" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="6dp">
        <LinearLayout android:id="@+id/p_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/p_time1" android:layout_width="44dp" android:layout_height="wrap_content" android:textColor="@color/r_muted" android:textSize="13sp" android:fontFeatureSettings="tnum" android:typeface="monospace" />
            <ImageView android:id="@+id/p_bar1" android:layout_width="4dp" android:layout_height="22dp" android:layout_marginStart="6dp" android:scaleType="fitXY" android:src="@drawable/bar" android:contentDescription="@null" />
            <TextView android:id="@+id/p_txt1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/r_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/p_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/p_time2" android:layout_width="44dp" android:layout_height="wrap_content" android:textColor="@color/r_muted" android:textSize="13sp" android:fontFeatureSettings="tnum" android:typeface="monospace" />
            <ImageView android:id="@+id/p_bar2" android:layout_width="4dp" android:layout_height="22dp" android:layout_marginStart="6dp" android:scaleType="fitXY" android:src="@drawable/bar" android:contentDescription="@null" />
            <TextView android:id="@+id/p_txt2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/r_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/p_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/p_time3" android:layout_width="44dp" android:layout_height="wrap_content" android:textColor="@color/r_muted" android:textSize="13sp" android:fontFeatureSettings="tnum" android:typeface="monospace" />
            <ImageView android:id="@+id/p_bar3" android:layout_width="4dp" android:layout_height="22dp" android:layout_marginStart="6dp" android:scaleType="fitXY" android:src="@drawable/bar" android:contentDescription="@null" />
            <TextView android:id="@+id/p_txt3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/r_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/p_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/p_time4" android:layout_width="44dp" android:layout_height="wrap_content" android:textColor="@color/r_muted" android:textSize="13sp" android:fontFeatureSettings="tnum" android:typeface="monospace" />
            <ImageView android:id="@+id/p_bar4" android:layout_width="4dp" android:layout_height="22dp" android:layout_marginStart="6dp" android:scaleType="fitXY" android:src="@drawable/bar" android:contentDescription="@null" />
            <TextView android:id="@+id/p_txt4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/r_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/p_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/p_time5" android:layout_width="44dp" android:layout_height="wrap_content" android:textColor="@color/r_muted" android:textSize="13sp" android:fontFeatureSettings="tnum" android:typeface="monospace" />
            <ImageView android:id="@+id/p_bar5" android:layout_width="4dp" android:layout_height="22dp" android:layout_marginStart="6dp" android:scaleType="fitXY" android:src="@drawable/bar" android:contentDescription="@null" />
            <TextView android:id="@+id/p_txt5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/r_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/p_row6" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/p_time6" android:layout_width="44dp" android:layout_height="wrap_content" android:textColor="@color/r_muted" android:textSize="13sp" android:fontFeatureSettings="tnum" android:typeface="monospace" />
            <ImageView android:id="@+id/p_bar6" android:layout_width="4dp" android:layout_height="22dp" android:layout_marginStart="6dp" android:scaleType="fitXY" android:src="@drawable/bar" android:contentDescription="@null" />
            <TextView android:id="@+id/p_txt6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/r_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/p_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/r_muted" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/p_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/r_accent" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
