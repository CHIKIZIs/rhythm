<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/d_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/d_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wbg" android:scaleType="fitXY" android:contentDescription="@null" />
    <ImageView android:id="@+id/d_sheen" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wbg_sheen" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/d_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <LinearLayout android:id="@+id/d_alarm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/chip_glass">
                <ImageView android:id="@+id/d_alarm_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_alarm" android:contentDescription="@null" />
                <TextView android:id="@+id/d_alarm_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_marginStart="6dp" android:maxWidth="150dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
                <TextView android:id="@+id/d_plan_h" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:text="ПЛАН" android:letterSpacing="0.08"/>
                <LinearLayout android:id="@+id/d_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
                    <TextView android:id="@+id/d_time1" android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="12sp" android:fontFeatureSettings="tnum" android:typeface="monospace" />
                    <ImageView android:id="@+id/d_bar1" android:layout_width="3dp" android:layout_height="16dp" android:scaleType="fitXY" android:src="@drawable/bar" android:contentDescription="@null" />
                    <TextView android:id="@+id/d_txt1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout android:id="@+id/d_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
                    <TextView android:id="@+id/d_time2" android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="12sp" android:fontFeatureSettings="tnum" android:typeface="monospace" />
                    <ImageView android:id="@+id/d_bar2" android:layout_width="3dp" android:layout_height="16dp" android:scaleType="fitXY" android:src="@drawable/bar" android:contentDescription="@null" />
                    <TextView android:id="@+id/d_txt2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <TextView android:id="@+id/d_plan_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" android:layout_marginTop="4dp" android:text="Свободный день"/>
            </LinearLayout>
            <Space android:layout_width="12dp" android:layout_height="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/d_task_h" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:text="ЗАДАЧИ" android:letterSpacing="0.08"/>
                    <TextView android:id="@+id/d_task_n" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_marginStart="6dp"/>
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <ImageView android:id="@+id/d_add" android:layout_width="22dp" android:layout_height="22dp" android:padding="5dp" android:background="@drawable/chip_glass" android:src="@drawable/ic_plus" android:contentDescription="Добавить задачу" />
                </LinearLayout>
                <LinearLayout android:id="@+id/dt_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
                    <ImageView android:id="@+id/dt_dot1" android:layout_width="16dp" android:layout_height="16dp" android:padding="4dp" android:src="@drawable/dot" android:contentDescription="@null" />
                    <TextView android:id="@+id/dt_txt1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout android:id="@+id/dt_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
                    <ImageView android:id="@+id/dt_dot2" android:layout_width="16dp" android:layout_height="16dp" android:padding="4dp" android:src="@drawable/dot" android:contentDescription="@null" />
                    <TextView android:id="@+id/dt_txt2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <TextView android:id="@+id/d_task_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" android:layout_marginTop="4dp" android:text="Задач нет"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>